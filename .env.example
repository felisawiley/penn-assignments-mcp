CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://canvas.upenn.edu

# Neon → Auth → Configuration. The one auth URL (.../neondb/auth).
NEON_AUTH_BASE_URL=
# This server's own address. Local: http://127.0.0.1:8000
# Render: https://<your-service>.onrender.com
PUBLIC_URL=http://127.0.0.1:8000
# Only this signed-in email may see the Canvas. Leave blank and every
# signed-in user can.
OWNER_EMAIL=

